# Function to remove foreign links/usernames and append your info
def clean_caption(text):
    if not text:
        return f"\n\n📢 Join: {MY_LINK}\n👤 Credit: {MY_USERNAME}"
    
    # Remove all URLs (http, https, t.me, www)
    text = re.sub(r'https?://\S+|www\.\S+|t\.me/\S+', '', text)
    # Remove foreign @usernames
    text = re.sub(r'@\w+', '', text)
    
    clean_text = text.strip()
    return f"{clean_text}\n\n📢 Join: {MY_LINK}\n👤 Credit: {MY_USERNAME}"

# Function to rename files and remove foreign channel tags
def clean_filename(original_name):
    if not original_name:
        original_name = "file"
    
    # Remove @username and brackets from filename
    name_clean = re.sub(r'@\w+', '', original_name)
    name_clean = re.sub(r'\[.*?\]|\(.*?\)', '', name_clean).strip()
    name_clean = " ".join(name_clean.split())
    
    # Add your channel prefix
    return f"[PhProMod] {name_clean}"

@bot.on_message(filters.command("start"))
async def start_command(client, message):
